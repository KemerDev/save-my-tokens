{
  "version": 1,
  "project": "save-my-tokens",
  "description": "Execution order for implementing the save-my-tokens MCP server from specifications.md.",
  "tasks": [
    {
      "id": "scaffold-package",
      "file": "scaffold-package.md",
      "phase": "foundation",
      "depends_on": [],
      "parallel_group": "foundation",
      "summary": "Create TypeScript package, baseline source tree, and test harness."
    },
    {
      "id": "config-and-cli",
      "file": "config-and-cli.md",
      "phase": "foundation",
      "depends_on": ["scaffold-package"],
      "parallel_group": "foundation",
      "summary": "Implement CLI flags and config precedence."
    },
    {
      "id": "mcp-server-and-shared-schemas",
      "file": "mcp-server-and-shared-schemas.md",
      "phase": "mcp-foundation",
      "depends_on": ["config-and-cli"],
      "parallel_group": "mcp-foundation",
      "summary": "Create MCP lifecycle, tool registration shell, schemas, and errors."
    },
    {
      "id": "file-tree-and-path-guardrails",
      "file": "file-tree-and-path-guardrails.md",
      "phase": "safe-indexing",
      "depends_on": ["config-and-cli"],
      "parallel_group": "safe-indexing",
      "summary": "Implement file discovery, safe reads, excludes, and path protections."
    },
    {
      "id": "typescript-symbol-index",
      "file": "typescript-symbol-index.md",
      "phase": "safe-indexing",
      "depends_on": ["file-tree-and-path-guardrails"],
      "parallel_group": "safe-indexing",
      "summary": "Build TypeScript/JavaScript symbol, import, export, and dependency index."
    },
    {
      "id": "snippet-and-token-budget",
      "file": "snippet-and-token-budget.md",
      "phase": "symbol-tools",
      "depends_on": ["mcp-server-and-shared-schemas", "file-tree-and-path-guardrails"],
      "parallel_group": "symbol-tools-a",
      "summary": "Implement exact snippets and shared token budgeting."
    },
    {
      "id": "summary-and-resolve-tools",
      "file": "summary-and-resolve-tools.md",
      "phase": "symbol-tools",
      "depends_on": ["mcp-server-and-shared-schemas", "typescript-symbol-index"],
      "parallel_group": "symbol-tools-a",
      "summary": "Implement file summary and symbol resolution tools."
    },
    {
      "id": "symbol-context-depth-one",
      "file": "symbol-context-depth-one.md",
      "phase": "symbol-tools",
      "depends_on": ["snippet-and-token-budget", "summary-and-resolve-tools", "typescript-symbol-index"],
      "parallel_group": "symbol-tools-b",
      "summary": "Implement core get_symbol_context depth 0 and 1."
    },
    {
      "id": "usage-and-dependency-tools",
      "file": "usage-and-dependency-tools.md",
      "phase": "dependency-tools",
      "depends_on": ["symbol-context-depth-one"],
      "parallel_group": "dependency-tools",
      "summary": "Implement usage context and dependency explanation tools."
    },
    {
      "id": "local-ai-adapter",
      "file": "local-ai-adapter.md",
      "phase": "dependency-tools",
      "depends_on": ["file-tree-and-path-guardrails", "snippet-and-token-budget"],
      "parallel_group": "dependency-tools",
      "summary": "Implement optional local-AI summaries and dependency ranking."
    },
    {
      "id": "task-retrieval-tools",
      "file": "task-retrieval-tools.md",
      "phase": "task-retrieval",
      "depends_on": ["usage-and-dependency-tools", "local-ai-adapter"],
      "parallel_group": "task-retrieval",
      "summary": "Implement ask_codebase and get_relevant_context."
    },
    {
      "id": "full-file-escape-hatch",
      "file": "full-file-escape-hatch.md",
      "phase": "hardening",
      "depends_on": ["summary-and-resolve-tools", "snippet-and-token-budget"],
      "parallel_group": "hardening-a",
      "summary": "Implement guarded full-file escape hatch."
    },
    {
      "id": "readme-agent-instructions",
      "file": "readme-agent-instructions.md",
      "phase": "documentation",
      "depends_on": ["mcp-server-and-shared-schemas"],
      "parallel_group": "hardening-a",
      "summary": "Create README, AGENTS.md, CLAUDE.md, and example config."
    },
    {
      "id": "integration-hardening-release",
      "file": "integration-hardening-release.md",
      "phase": "release",
      "depends_on": ["task-retrieval-tools", "full-file-escape-hatch", "readme-agent-instructions"],
      "parallel_group": "release",
      "summary": "Run final fixture integration, hardening, release readiness checks."
    }
  ],
  "parallelization_notes": [
    "After config-and-cli, MCP schema work and file-tree guardrail work can proceed independently.",
    "snippet-and-token-budget and summary-and-resolve-tools can proceed in parallel after their dependencies land.",
    "usage-and-dependency-tools and local-ai-adapter can proceed in parallel after core symbol context and guardrails are available.",
    "Documentation can begin once public tool names and schemas are stable."
  ],
  "release_gate": {
    "commands": [
      "npm run build",
      "npm run typecheck",
      "npm run lint",
      "npm run test"
    ],
    "required_artifacts": [
      "README.md",
      "AGENTS.md",
      "CLAUDE.md",
      ".save-my-tokens.example.json",
      "dist/cli.js"
    ]
  }
}
